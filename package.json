{
  "name": "claude-agent-monitor",
  "version": "2.0.0",
  "description": "实时监控本地 Claude Code / Desktop agent 会话状态（扫描 ~/.claude/projects 下的 .jsonl，无需 MCP）",
  "type": "module",
  "main": "electron/main.js",
  "author": "claude-agent-monitor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbbz000/claude-agent-monitor.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "monitor",
    "agent",
    "electron",
    "taskbar"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "monitor": "node monitor.js",
    "sessions": "node sessions.js",
    "bridge": "node hardware/bridge/serial-bridge.js",
    "bar": "electron .",
    "bar:dev": "electron . --dev",
    "bar:diag": "electron . --diag --dev",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.claude.agent-monitor",
    "productName": "ClaudeAgentMonitor",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "core/**/*",
      "hardware/led-frame.js",
      "hardware/led-serial.js",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/serialport/**",
      "**/node_modules/@serialport/**"
    ],
    "npmRebuild": true,
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ClaudeAgentMonitor-${version}-portable.exe"
    }
  }
}
